include LICENSE
recursive-include PlanetProfile/* *.py
recursive-include PlanetProfile/* *.txt
recursive-include PlanetProfile/* *.tab
recursive-include PlanetProfile/* *.mat
recursive-include PlanetProfile/* *.tf
recursive-include PlanetProfile/* *.tls
recursive-include PlanetProfile/* *.tpc
recursive-include PlanetProfile/* *.md
global-exclude *Ref.txt
global-exclude Test*Profile*.txt
global-exclude Test*.mat
# First exclude all .dat files
recursive-exclude PlanetProfile *.dat
# Then re-include only the ones you want
recursive-include PlanetProfile/Thermodynamics/Reaktoro/Databases *.dat
# Exclude large Perple_X data files (downloaded automatically during install)
global-exclude PlanetProfile/Thermodynamics/EOStables/Perple_X/*.tab
global-exclude PlanetProfile/Thermodynamics/EOStables/Perple_X/*.mat